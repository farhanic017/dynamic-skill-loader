{
  "name": "skill-dispatcher",
  "version": "3.0.0",
  "description": "Universal MCP skill dispatcher for AI coding agents. Load Claude Code, OpenCode, Cursor, Gemini, command, and GitHub-hosted skills on demand.",
  "type": "module",
  "bin": {
    "skill-dispatcher": "./index.mjs"
  },
  "scripts": {
    "test": "node aggressive-test.mjs",
    "test:quick": "node test.mjs",
    "start": "node index.mjs --skills-dir ./skills",
    "list": "node index.mjs --skills-dir ./skills --list"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "ai-agent",
    "ai-agents",
    "agent-tools",
    "skills",
    "claude",
    "claude-code",
    "opencode",
    "cursor",
    "cursor-ai",
    "windsurf",
    "codex",
    "gemini-cli",
    "ai-coding",
    "ai-coding-assistant",
    "coding-assistant",
    "skill-loader",
    "skill-dispatcher",
    "trigger-matching",
    "prompt-engineering",
    "context-management",
    "developer-tools"
  ],
